# Base URL of the crypto-payments Supabase Edge Function
NEXT_PUBLIC_API_URL=https://krjbwbvmrpazdmmjstzo.supabase.co/functions/v1/crypto-payments

# Reown (WalletConnect) Project ID — register free at https://dashboard.reown.com
# Required for AppKit mobile QR connect (Coinbase Wallet, Rabby mobile)
# Production value is set in Vercel project env vars (NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID)
# CI value is set in GitHub secrets (REOWN_PROJECT_ID)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_reown_project_id_here
